# Canonical public site URL (no trailing slash).
# Used at build time for sitemap, RSS, and absolute meta URLs.
# Localhost values are ignored in favor of content/config.json.
NEXT_PUBLIC_BASE_URL=https://example.com

# Optional URL prefix when the site is not served from the domain root.
# Leave empty for a user/organization GitHub Pages site (owner.github.io).
NEXT_PUBLIC_BASE_PATH=

# Commentbox.io project ID for blog comments. Leave empty to disable comments.
NEXT_PUBLIC_COMMENTBOX_PROJECT_ID=

# Google Analytics measurement ID. Leave empty to skip loading analytics.
NEXT_PUBLIC_GA_TRACKING_ID=
